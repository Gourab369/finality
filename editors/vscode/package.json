{
  "name": "finality-bridge",
  "displayName": "Finality Bridge",
  "description": "Lets the Finality coding agent use VS Code's language features (diagnostics, definitions, references, symbols, hover) over a local MCP server.",
  "version": "0.4.0",
  "publisher": "finality",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "finality.bridgeStatus",
        "title": "Finality: Show Bridge Status"
      }
    ],
    "configuration": {
      "title": "Finality Bridge",
      "properties": {
        "finality.dataDir": {
          "type": "string",
          "default": "",
          "description": "Finality's data directory. Empty: FINALITY_HOME, else ~/.finality. Set it if Finality's config moves general.data_dir."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.6.0"
  }
}
